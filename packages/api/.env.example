# Required when scanning listed bases through OpenSea.
OPENSEA_API_KEY=

# Optional comma-separated production origins allowed to call the API.
API_ALLOWED_ORIGINS=

# Optional. If omitted, the API falls back to a public Ethereum RPC endpoint.
ETH_RPC_URL=
RPC_URL=
ALCHEMY_API_KEY=

# Local dev defaults to 3001. Fly sets PORT=3000 in fly.toml.
PORT=3001

# Cost/rate guards for hosted API deployments.
API_RATE_LIMIT=10
API_RATE_LIMIT_WINDOW_MS=60000
MAX_TOP=25
MAX_BATCH_SIZE=100
MAX_OPENSEA_PAGES=5
MAX_LISTED_TOKEN_IDS=500
MAX_OWNER_RPC_SCAN_RANGE=500

# Keep disabled for public deployments unless you intentionally want heavier scans.
# ALLOW_FULL_COLLECTION_SCAN=false
# ALLOW_MANUAL_REFRESH=false
